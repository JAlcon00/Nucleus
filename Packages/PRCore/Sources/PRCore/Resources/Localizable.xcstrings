    "Estable (pocos cambios)" : { "comment" : "Preferencia de variedad de ejercicios", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stable (few changes)" } } } },
    "Equilibrada" : { "comment" : "Preferencia de variedad de ejercicios", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Balanced" } } } },
    "Variada" : { "comment" : "Preferencia de variedad de ejercicios", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Varied" } } } },
    "%@ × %lld" : {
      "comment" : "Carga del récord: peso con unidad × repeticiones. Ej.: 85 kg × 8",
      "localizations" : {
