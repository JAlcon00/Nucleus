    "Guardado en Salud" : { "comment" : "Resumen: el entrenamiento ya está en Salud", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Saved to Health" } } } },
    "Se guardará en Salud" : { "comment" : "Resumen: el entrenamiento aún no llega a Salud; no es un error", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Will be saved to Health" } } } },
    "Energía activa · Apple Watch" : { "comment" : "Origen de la energía de la sesión", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Active energy · Apple Watch" } } } },
    "Energía activa · otra app" : { "comment" : "Origen de la energía de la sesión", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Active energy · other app" } } } },
    "Energía estimada" : { "comment" : "Nunca se presenta una estimación como medida", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Estimated energy" } } } },
    "Salud general" : { "comment" : "Objetivo de entrenamiento", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "General health" } } } },
    "Hipertrofia" : { "comment" : "Objetivo de entrenamiento: ganar músculo", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hypertrophy" } } } },
    "Fuerza" : { "comment" : "Objetivo de entrenamiento", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Strength" } } } },
    "Powerbuilding" : { "comment" : "Objetivo: fuerza e hipertrofia combinadas", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Powerbuilding" } } } },
    "Recomposición" : { "comment" : "Objetivo: perder grasa y ganar músculo a la vez", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Recomposition" } } } },
    "Culturismo" : { "comment" : "Objetivo de entrenamiento", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Bodybuilding" } } } },
    "Volumen (superávit)" : { "comment" : "Fase: comer por encima del mantenimiento", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Bulking (surplus)" } } } },
    "Definición (déficit)" : { "comment" : "Fase: comer por debajo del mantenimiento", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cutting (deficit)" } } } },
    "Mantenimiento" : { "comment" : "Fase: peso estable", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Maintenance" } } } },
    "Prefiero no decirlo" : { "comment" : "Fase sin especificar", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Prefer not to say" } } } },
    "Novato" : { "comment" : "Nivel de experiencia", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Novice" } } } },
    "Principiante" : { "comment" : "Nivel de experiencia", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Beginner" } } } },
    "Intermedio" : { "comment" : "Nivel de experiencia", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Intermediate" } } } },
    "Avanzado" : { "comment" : "Nivel de experiencia", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Advanced" } } } },
    "Competitivo" : { "comment" : "Nivel de experiencia", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Competitive" } } } },
    "Estable (pocos cambios)" : { "comment" : "Preferencia de variedad de ejercicios", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stable (few changes)" } } } },
    "Equilibrada" : { "comment" : "Preferencia de variedad de ejercicios", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Balanced" } } } },
    "Variada" : { "comment" : "Preferencia de variedad de ejercicios", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Varied" } } } },
    "%@ × %lld" : {
      "comment" : "Carga del récord: peso con unidad × repeticiones. Ej.: 85 kg × 8",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%1$@ × %2$lld" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "%1$@ × %2$lld" } }
      }
    },
    "%@, %@ por %@" : {
      "comment" : "VoiceOver: un récord. Ej.: Press banca, 85 kilogramos por 8 repeticiones",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%1$@, %2$@ for %3$@" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "%1$@, %2$@ por %3$@" } }
      }
    },
    "%@: %@." : {
      "comment" : "VoiceOver al aparecer la celebración: titular y lista de récords",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%1$@: %2$@." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "%1$@: %2$@." } }
      }
    },
    "%lld nuevos récords" : {
      "comment" : "Titular de la celebración con varios récords (count ≥ 2)",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld new records" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "%lld nuevos récords" } }
      }
    },
    "%lld repeticiones" : {
      "comment" : "Número de repeticiones (con variación singular/plural)",
      "localizations" : {
