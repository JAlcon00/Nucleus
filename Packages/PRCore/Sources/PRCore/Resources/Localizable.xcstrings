              "one" : { "stringUnit" : { "state" : "translated", "value" : "%lld repetición" } },
              "other" : { "stringUnit" : { "state" : "translated", "value" : "%lld repeticiones" } }
            }
          }
        }
      }
    },
    "Ejercicio" : {
      "comment" : "Nombre genérico si el ejercicio no está en el catálogo",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Exercise" } }
      }
    },
    "Levantaste más que tu mejor carga registrada. Así se ve la sobrecarga progresiva: el plan decidirá en la próxima sesión si conviene subir." : {
      "comment" : "Explicación para nivel guiado tras un récord",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You lifted more than your best recorded load. That's progressive overload: the plan will decide next session whether to go up." } }
      }
    },
    "Nuevo récord" : {
      "comment" : "Titular de la celebración con un solo récord",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "New record" } }
      }
    },
    "Superaste tu mejor carga registrada." : {
      "comment" : "Explicación breve para nivel balanceado tras un récord",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You beat your best recorded load." } }
      }
    },
    "Push" : {
